# ==============================================================================
# Adaptive Interview Intelligence - VFSTR
# ISOLATED ATLAS TEST ENVIRONMENT TEMPLATE (.env.test.example)
#
# IMPORTANT SECURITY & ISOLATION INSTRUCTIONS:
# 1. Copy this file to '.env.test' (which is strictly excluded by .gitignore).
# 2. Configure MONGODB_URI with your Atlas connection string.
# 3. MONGODB_DB_NAME MUST be set to an isolated test database (e.g. 'vfstr_interview_test').
# 4. INTERVIEW_DB_NAME MUST be set to an isolated test database (e.g. 'interview_db_test').
# 5. ENVIRONMENT must be set to 'test'.
#
# FAIL-SAFE GUARD:
# The application startup validator will FATALLY REJECT startup if ENVIRONMENT='test'
# and either MONGODB_DB_NAME or INTERVIEW_DB_NAME are set to production targets
# ('vfstr_interview', 'interview_db', 'admin', 'local', 'config') or lack 'test'.
# ==============================================================================

PROJECT_NAME="Adaptive Interview Intelligence - VFSTR (Atlas Isolated Test)"
VERSION="1.0.0"
API_V1_STR="/api"
HOST="127.0.0.1"
PORT=8000
ENVIRONMENT="test"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://vfstrinterview.vercel.app"]

# MongoDB Atlas Test Connection (Replace placeholders - NEVER commit secrets)
MONGODB_URI="mongodb+srv://<TEST_DB_USER>:<TEST_DB_PASSWORD>@<ATLAS_CLUSTER_HOST>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="vfstr_interview_test"
INTERVIEW_DB_NAME="interview_db_test"

# JWT Authentication Test Settings
JWT_SECRET_KEY="vfstr_test_isolated_secret_key_9f30b2c5d6e7f801a2b3c4d5e6f7a8b9"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER="vfstr-interview"
JWT_AUDIENCE="vfstr-interview-client"

# Abuse Protection
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Demo Mode & Email Disablement
DEMO_MODE=true
EMAIL_DISPATCH_ENABLED=false

# Adaptive Interview Evaluation Engine Configuration
# Select evaluator: "mock" (offline deterministic rubric), "gemini" (Google AI Studio), or "nemotron" (NVIDIA NIM)
AI_PROVIDER="mock"
AI_FALLBACK_PROVIDER=""  # Optional secondary fallback: "gemini", "mock", or leave empty
GEMINI_API_KEY=""  # Required if AI_PROVIDER="gemini" (never commit real keys)
NVIDIA_API_KEY=""  # Required if AI_PROVIDER="nemotron" (starts with nvapi-..., never commit real keys)
AI_MODEL_NAME="gemini-1.5-flash"  # e.g. "gemini-1.5-flash" or "gemini-2.0-flash"
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
NEMOTRON_DEFAULT_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT_SECONDS=20.0
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_RETRY_BACKOFF_FACTOR=1.5
AI_RETRY_MAX_DELAY_SECONDS=10.0
AI_TOTAL_REQUEST_DEADLINE_SECONDS=30.0
AI_MAX_OUTPUT_TOKENS=1024
INTERVIEW_TOTAL_QUESTIONS_DEFAULT=5
ALLOW_MOCK_EVALUATOR_FALLBACK=true

