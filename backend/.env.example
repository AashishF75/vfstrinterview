PROJECT_NAME="Adaptive Interview Intelligence - VFSTR"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://vfstrinterview.vercel.app"]

# MongoDB Atlas Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="vfstr_interview"
INTERVIEW_DB_NAME="interview_db"

# Environment
ENVIRONMENT="development"

# Authentication & JWT Security (Change in production)
JWT_SECRET_KEY="replace_with_a_secure_random_256_bit_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER="vfstr-interview"
JWT_AUDIENCE="vfstr-interview-client"

# Login Rate Limiting (Abuse Protection)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Administrator Bootstrap Configuration (CLI provisioning is preferred: python -m app.cli.bootstrap_admin)
BOOTSTRAP_ADMIN_EMAIL="admin@vfstr.ac.in"
BOOTSTRAP_ADMIN_PASSWORD="replace_with_secure_bootstrap_admin_password"
BOOTSTRAP_SECRET_KEY="replace_with_dedicated_bootstrap_secret_token"
ENABLE_BOOTSTRAP_ENDPOINT=false

# Adaptive Interview Evaluation Engine Configuration
# Select evaluator: "mock" (offline deterministic rubric) or "gemini" (Google AI Studio)
AI_PROVIDER="mock"
GEMINI_API_KEY=""  # Required if AI_PROVIDER="gemini" (never commit real keys)
AI_MODEL_NAME="gemini-1.5-flash"
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"
GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT_SECONDS=20.0
INTERVIEW_TOTAL_QUESTIONS_DEFAULT=5
ALLOW_MOCK_EVALUATOR_FALLBACK=true

# Sandboxed Code Execution Service Configuration (Judge0 Compatible Engine)
# IMPORTANT: In production (Render), NEVER use "http://localhost:2358" or "http://127.0.0.1:2358".
#
# Option 1: Official Public Judge0 Community Edition (Zero-key testing for prototype demonstrations)
# JUDGE0_API_URL="https://ce.judge0.com"
# JUDGE0_API_KEY=""
# JUDGE0_API_HOST=""
# JUDGE0_AUTH_TOKEN=""
#
# Option 2: Judge0 CE via RapidAPI (Free Basic or Paid Tier)
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY="your_rapidapi_key_here"
# JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"
# JUDGE0_AUTH_TOKEN=""
#
# Option 3: Dedicated Self-Hosted Instance (Oracle Cloud, VPS, or Docker container)
# JUDGE0_API_URL="https://your-judge0-domain.example.com"
# JUDGE0_AUTH_TOKEN="your_optional_auth_token_here"
JUDGE0_API_URL=""
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""
JUDGE0_AUTH_TOKEN=""
CODE_EXECUTION_TIMEOUT_SECONDS=12.0
CODE_EXECUTION_CPU_TIME_LIMIT=5.0
CODE_EXECUTION_WALL_TIME_LIMIT=10.0
CODE_EXECUTION_MEMORY_LIMIT_KB=128000
CODE_EXECUTION_MAX_SOURCE_LENGTH=65536
CODE_EXECUTION_MAX_INPUT_LENGTH=16384


