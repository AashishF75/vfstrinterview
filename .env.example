# ==========================================
# Adaptive Interview Intelligence - VFSTR
# Root Environment Reference Configuration
# ==========================================

# Backend Configuration (backend/.env)
PROJECT_NAME="Adaptive Interview Intelligence - VFSTR"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MongoDB Atlas Database
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="vfstr_interview"
ENVIRONMENT="development"

# Authentication & JWT Security
JWT_SECRET_KEY="replace_with_a_secure_random_256_bit_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER="vfstr-interview"
JWT_AUDIENCE="vfstr-interview-client"

# Login Rate Limiting (Abuse Protection)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Bootstrap Initial Administrator (CLI provisioning preferred: python -m app.cli.bootstrap_admin)
BOOTSTRAP_ADMIN_EMAIL="admin@vfstr.ac.in"
BOOTSTRAP_ADMIN_PASSWORD="replace_with_secure_bootstrap_admin_password"
BOOTSTRAP_SECRET_KEY="replace_with_dedicated_bootstrap_secret_token"
ENABLE_BOOTSTRAP_ENDPOINT=false

# Frontend Configuration (frontend/.env)
VITE_API_URL="http://127.0.0.1:8000"
